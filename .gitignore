seguridad_config.js
seguridad_admin_pin.js
test_config.js
_fix_views.js
admin/audit.js
admin/verify_fotos.js
admin/test_full.js
admin/test_auth.js
admin/create_admin.js
admin/migrate_users.js
admin/sync_claims.js
admin/migrate_fotos.js
admin/migrate_fotos_fast.js
admin/setup_storage.js
clients/*/config.json
supabase/.temp/
.env
.env.*
!.env.example

# ═══ HTML — excluir login eliminado ═══
