{
  "name": "SISTEPARD Multi-Agent Ecosystem",
  "version": "1.0.0",
  "description": "Ecosistema multi-agente con aprendizaje continuo, memoria persistente y compresión de contexto",
  
  "project": {
    "id": "sistepard",
    "root": ".",
    "primary_language": "es",
    "code_language": "javascript",
    "framework": "vanilla-html+supabase"
  },

  "agents": {
    "default": "general",
    "registry": {
      "general": "agents/general.md",
      "security": "agents/security-auditor.md",
      "refactor": "agents/refactor-specialist.md",
      "qa": "agents/qa-tester.md",
      "reviewer": "agents/code-reviewer.md",
      "observer": "agents/task-observer.md",
      "architect": "agents/architect.md"
    }
  },

  "skills": {
    "auto_discover": true,
    "auto_generate": true,
    "min_confidence": 0.7,
    "max_skills_per_session": 5,
    "skills_dir": "skills/",
    "pattern_detection": {
      "enabled": true,
      "min_repetitions": 3,
      "window_size": 10
    }
  },

  "memory": {
    "enabled": true,
    "backend": "file",
    "dir": "memory/",
    "max_entries": 1000,
    "auto_index": true,
    "compression": "summary",
    "ttl_days": 90
  },

  "context": {
    "compression": {
      "enabled": true,
      "strategy": "smart",
      "max_tokens": 8000,
      "preserve_ratio": 0.3,
      "dedup": true,
      "summarize_threshold": 500
    },
    "cache": {
      "enabled": true,
      "dir": "cache/",
      "ttl_hours": 24
    }
  },

  "router": {
    "enabled": true,
    "strategy": "fallback",
    "providers": [
      {
        "id": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "priority": 1,
        "rate_limit": { "rpm": 50, "tpd": 1000000 }
      },
      {
        "id": "google",
        "model": "gemini-2.5-pro",
        "priority": 2,
        "rate_limit": { "rpm": 30, "tpd": 500000 }
      },
      {
        "id": "openai",
        "model": "gpt-4o",
        "priority": 3,
        "rate_limit": { "rpm": 40, "tpd": 800000 }
      }
    ],
    "fallback_cooldown_seconds": 60,
    "health_check_interval_seconds": 300
  },

  "hooks": {
    "pre_task": "hooks/pre-task.sh",
    "post_task": "hooks/post-task.sh",
    "pre_context": "hooks/pre-context.sh",
    "post_context": "hooks/post-context.sh",
    "on_error": "hooks/on-error.sh",
    "on_session_end": "hooks/on-session-end.sh"
  },

  "mcp": {
    "servers": {
      "filesystem": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
      },
      "supabase": {
        "command": "npx",
        "args": ["-y", "@supabase/mcp-server"],
        "env": {
          "SUPABASE_URL": "https://ilivjaiexfqpioqrozlf.supabase.co",
          "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
        }
      }
    }
  },

  "purge": {
    "auto_clean": true,
    "max_log_size_mb": 10,
    "max_cache_age_days": 7,
    "patterns": ["*.log", "*.tmp", "cache/*"]
  }
}
